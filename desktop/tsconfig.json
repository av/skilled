{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": ["ui/**/*.ts", "ui/**/*.tsx", "tests/**/*.ts", "scripts/**/*.ts", "../src/models.ts", "../src/data.ts", "../src/view.ts", "../src/noise.ts"]
}
